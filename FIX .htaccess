RewriteEngine On

# ✅ Force HTTPS + WWW
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.rbsnetworksolutionsblr\.com$ [NC]
RewriteRule ^(.*)$ https://www.rbsnetworksolutionsblr.com/$1 [L,R=301]

# ✅ Redirect index.html → root
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^index\.html$ https://www.rbsnetworksolutionsblr.com/ [R=301,L]

# ✅ Remove duplicate trailing slash (except folders)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]
